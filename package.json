{
  "name": "komunicare-api",
  "version": "1.3.1",
  "description": "Komunicare API powers the AAC platform backend for boards, communicators, users, subscriptions, media, and core product content.",
  "keywords": [
    "aac",
    "autism",
    "cerebral-palsy",
    "progressive-web-app",
    "communication-board",
    "speech",
    "language",
    "tts",
    "text-to-speech"
  ],
  "homepage": "https://komunicare.com.ar",
  "private": false,
  "license": "GPL-3.0-only",
  "author": "Damian Lluch <damianclluch@gmail.com>",
  "contributors": [
    "Damian Lluch <damianclluch@gmail.com>"
  ],
  "main": "app.js",
  "dependencies": {
    "@aws-sdk/client-ses": "^3.699.0",
    "@nestjs/common": "^11.1.14",
    "@nestjs/core": "^11.1.14",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.1.14",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@paypal/checkout-server-sdk": "^1.0.3",
    "@snyk/protect": "1.1056.0",
    "@types/bcryptjs": "^2.4.6",
    "axios": "^1.7.2",
    "azure-storage": "^2.10.6",
    "bcryptjs": "^2.4.3",
    "body-parser": "1.20.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "connect-mongo": "^3.2.0",
    "cors": "^2.8.5",
    "dotenv": "^8.6.0",
    "dotenv-defaults": "2.0.2",
    "express": "^4.17.3",
    "express-async-errors": "^3.1.1",
    "express-session": "^1.17.3",
    "googleapis": "^110.0.0",
    "https": "^1.0.0",
    "jsonwebtoken": "^9.0.0",
    "mercadopago": "^2.3.0",
    "mockery": "^2.1.0",
    "moment": "2.29.4",
    "mongoose": "^5.13.15",
    "morgan": "^1.10.0",
    "ms": "^2.1.3",
    "node-ipinfo": "^3.4.0",
    "nodemailer": "^8.0.7",
    "pem": "^1.14.6",
    "rand-token": "0.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "should": "^13.2.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "translate-api": "^0.3.18",
    "uuid": "^3.4.0",
    "validator": "^13.9.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/morgan": "^1.9.9",
    "@types/nodemailer": "^8.0.0",
    "@types/paypal__checkout-server-sdk": "^1.0.8",
    "@types/pem": "^1.14.4",
    "@types/socket.io": "^3.0.2",
    "husky": "^4.2.0",
    "lint-staged": "^10.0.2",
    "nock": "^13.2.9",
    "nodemailer-mock": "^1.5.8",
    "nodemon": "^1.19.4",
    "prettier": "^1.19.1",
    "socket.io-client": "^4.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "scripts": {
    "build-docker": "docker compose -f docker-compose.local.yml build",
    "run-docker": "docker rm -f komunicare-api-public-local komunicare-mailhog >/dev/null 2>&1 || true && docker compose -f docker-compose.local.yml up -d",
    "run-docker-https": "docker rm -f komunicare-api-public-local komunicare-mailhog >/dev/null 2>&1 || true && DEV_ENV_WITH_HTTPS=1 docker compose -f docker-compose.local.yml up -d",
    "stop-docker": "docker compose -f docker-compose.local.yml down --remove-orphans && (docker rm -f komunicare-api-public-local komunicare-mailhog >/dev/null 2>&1 || true)",
    "dev": "ts-node src/app.ts",
    "dev-https": "DEV_ENV_WITH_HTTPS=1 npm run dev",
    "start": "node dist/app.js",
    "start:local": "ts-node src/app.ts",
    "build": "rm -rf dist && tsc",
    "start-build": "npm run build && npm run start",
    "precommit": "lint-staged",
    "snyk-protect": "snyk-protect",
    "prepare": "npm run snyk-protect",
    "test": "node --require ts-node/register/transpile-only --test test/api/*.ts test/controllers/*.ts test/e2e/*.ts test/services/*.ts",
    "dev:nest": "ts-node src/nest/main.ts",
    "start:nest": "node dist/nest/main.js"
  },
  "lint-staged": {
    "*.{js,json,css}": [
      "prettier --write",
      "git add"
    ]
  },
  "engines": {
    "node": ">=6.0"
  },
  "snyk": true
}
